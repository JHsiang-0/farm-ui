# 后端 HTTP 服务地址（Vite 开发代理目标）
# 前端生产环境实际访问的后端 HTTP 地址；桌面安装包必须配置
VITE_API_BASE_URL=http://localhost:8080

# 后端 HTTP 服务地址（仅用于 Vite 开发代理）
VITE_API_TARGET=http://localhost:8080

# 后端 WebSocket 服务地址（Vite 开发代理目标）
VITE_WS_TARGET=ws://localhost:8080

# 浏览器实际连接的 WebSocket 地址；留空时由前端根据当前页面地址推导
VITE_WS_URL=

# 是否监听局域网地址：true 时开发服务器监听 0.0.0.0
VITE_HOST=false

# 是否启用前端模拟数据
VITE_USE_MOCK=false
